{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run python scripts/dev.py:*)",
      "PowerShell(uv sync:*)",
      "PowerShell(uv run python scripts/dev.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/scripts/hooks/format_changed.py\""
          }
        ]
      }
    ]
  }
}
